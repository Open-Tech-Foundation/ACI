{
  "comment": [
    "Editor support only — this project is plain JavaScript and emits no",
    "declarations. `types` is what makes an editor resolve `runtime:fs` and",
    "`runtime:test` rather than marking them unresolved."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["@opentf/esrun-types"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "bin"]
}
