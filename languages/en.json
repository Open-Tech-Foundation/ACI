{
  "name": "english",
  "symbols": {
    "letter": {
      "characters": "abcdefghijklmnopqrstuvwxyz"
    },
    "vowel": {
      "characters": "aeiou"
    },
    "punctuation": {
      "characters": ". , ! ? ; : ' \" - ( ) [ ]"
    }
  },
  "words": {
    "hi":    { "pos": "interjection", "meaning": "greeting",  "concept": 277 },
    "hello": { "pos": "interjection", "meaning": "greeting",  "concept": 277 },
    "a":     { "pos": "article",      "meaning": "indefinite article" },
    "the":   { "pos": "article",      "meaning": "definite article" },
    "is":    { "pos": "verb",         "meaning": "to be",          "concept": 294 },
    "are":   { "pos": "verb",         "meaning": "to be (plural)", "concept": 294 },
    "one":   { "pos": "numeral",      "meaning": "1",              "concept": 114 },
    "two":   { "pos": "numeral",      "meaning": "2",              "concept": 115 },
    "three": { "pos": "numeral",      "meaning": "3",              "concept": 116 },
    "cat":   { "pos": "noun",         "meaning": "feline animal",  "concept": 83 },
    "dog":   { "pos": "noun",         "meaning": "canine animal",  "concept": 82 },
    "apple": { "pos": "noun",         "meaning": "fruit",          "concept": 79 },
    "bird":  { "pos": "noun",         "meaning": "flying animal",  "concept": 85 },
    "tree":  { "pos": "noun",         "meaning": "plant",          "concept": 33 }
  },
  "expressions": {
    "greet":      "Hello!",
    "count":      "It is {meaning}.",
    "confirm":    "Yes, it {meaning}.",
    "recognise":  "I recognise \"{meaning}\".",
    "understood": "I understand.",
    "affirm":     "Yes.",
    "deny":       "No.",
    "unknown":    "..."
  },
  "grammar": {
    "start": "sentence",
    "rules": {
      "sentence": {
        "rules": [
          "interjection",
          "interjection sentence",
          "subject predicate"
        ]
      },
      "subject": {
        "rules": ["noun", "article noun", "numeral noun"]
      },
      "predicate": {
        "rules": ["verb verbComplement"]
      },
      "verbComplement": {
        "rules": ["noun", "numeral", "article noun"]
      }
    }
  }
}
