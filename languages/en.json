  "grammar": {
    "start": "sentence",
    "rules": {
      "sentence": {
        "rules": [
          "interjection",
          "interjection sentence",
          "subject predicate",
          "interrogative verb subject",
          "interrogative quantifier subject",
          "verb subject preposition subject"
        ]
      },
      "subject": {
        "rules": ["noun", "article noun", "numeral", "numeral noun", "pronoun", "pronoun noun"]
      },
      "predicate": {
        "rules": ["verb verbComplement"]
      },
      "verbComplement": {
        "rules": [
          "noun",
          "numeral",
          "article noun",
          "numeral noun",
