{
  "targets": {
    "web": {
      "entry": "demo/index.html",
      "outdir": "demo/dist"
    },
    "server": {
      "entry": "demo/server.js",
      "outdir": "demo/dist"
    }
  },
  "start": {
    "run": "server"
  },
  "permissions": {
    "allow": {
      "read": [
        "."
      ],
      "listen": [
        "4199"
      ],
      "env": [
        "PORT"
      ]
    }
  }
}
