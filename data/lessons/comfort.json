{
  "forms": {
    "cold": "cold",
    "chilly": "cold",
    "freezing": "cold",
    "hot": "hot",
    "stuffy": "hot",
    "heater": "heater",
    "fan": "fan"
  },
  "relations": [
    ["cold", "is-a", "discomfort"],
    ["hot", "is-a", "discomfort"],
    ["heater", "remedy-for", "cold"],
    ["fan", "remedy-for", "hot"]
  ],
  "rules": [
    {
      "when": "discomfort",
      "respond": "offer-remedy",
      "slots": { "remedy": { "relation": "remedy-for", "of": "subject" } }
    }
  ],
  "responses": {
    "offer-remedy": "shall I put the {remedy} on?"
  }
}
